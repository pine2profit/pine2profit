//@version=5
strategy("SMA Cross 20/50", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100)
fastLen = input.int(20, "Fast SMA", minval=1)
slowLen = input.int(50, "Slow SMA", minval=1)
fast = ta.sma(close, fastLen)
slow = ta.sma(close, slowLen)
plot(fast, "Fast SMA", color=color.new(color.teal, 0))
plot(slow, "Slow SMA", color=color.new(color.orange, 0), linewidth=2)
if ta.crossover(fast, slow)
    strategy.entry("Long", strategy.long)
if ta.crossunder(fast, slow)
    strategy.close("Long")
