{
  "name": "pine2profit",
  "version": "1.4.0",
  "description": "Can money be made on this? A static dashboard for an AI agent that loops over TradingView Pine Script indicators and strategies and reports whether trading their alerts makes money. Ships the site, a local preview server for the agent's data folder (plain GET, no API) and a strict validator of the data contract; the same files publish to GitHub Pages unchanged.",
  "keywords": [
    "pine-script",
    "pinescript",
    "tradingview",
    "trading",
    "backtest",
    "backtesting",
    "paper-trading",
    "trading-strategy",
    "indicator",
    "strategy",
    "alerts",
    "cryptocurrency",
    "crypto",
    "ai-agent",
    "agent-loop",
    "llm",
    "claude-code",
    "dashboard",
    "report",
    "static-site",
    "github-pages",
    "nextjs",
    "react",
    "candlestick",
    "chart",
    "jsonl",
    "cli",
    "typescript"
  ],
  "homepage": "https://github.com/pine2profit/pine2profit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pine2profit/pine2profit.git"
  },
  "bugs": {
    "url": "https://github.com/pine2profit/pine2profit/issues"
  },
  "author": {
    "name": "Petr Tripolsky",
    "email": "tripolskypetr@gmail.com",
    "url": "https://github.com/tripolskypetr"
  },
  "license": "MIT",
  "files": [
    "build",
    "types.d.ts",
    "README.md"
  ],
  "scripts": {
    "start": "npm run build:modules && npm run serve",
    "serve": "node ./build/index.mjs .",
    "build": "rollup -c",
    "build:modules": "npm run build:modules:x",
    "build:modules:x": "sh ./scripts/linux/build.sh && npm run build:copy && npm run build:postbuild",
    "build:modules:win": ".\\scripts\\win\\build.bat && npm run build:copy && npm run build:postbuild",
    "build:copy": "node ./scripts/copy.mjs",
    "build:postbuild": "node ./scripts/postbuild.mjs",
    "prepublishOnly": "npm run build:modules"
  },
  "main": "build/index.cjs",
  "module": "build/index.mjs",
  "source": "src/index.ts",
  "types": "./types.d.ts",
  "exports": {
    "types": "./types.d.ts",
    "require": "./build/index.cjs",
    "import": "./build/index.mjs",
    "default": "./build/index.cjs"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-typescript": "11.1.6",
    "@types/finalhandler": "1.2.3",
    "@types/mime-types": "2.1.4",
    "@types/node": "22.9.0",
    "@types/serve-handler": "6.1.4",
    "glob": "11.0.1",
    "rimraf": "6.0.1",
    "rollup": "3.29.5",
    "rollup-plugin-dts": "6.1.1",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "touch": "3.1.1",
    "tslib": "2.7.0",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "di-kit": "1.1.1",
    "finalhandler": "1.3.2",
    "functools-kit": "5.0.0",
    "micro": "10.0.1",
    "mime-types": "2.1.18",
    "router": "1.3.8",
    "serve-handler": "6.1.6"
  },
  "bin": {
    "pine2profit": "./build/index.mjs"
  }
}
